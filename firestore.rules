rules_version = '2';

// Blacfox — Star Worker of the Week
// -----------------------------------------------------------------
// HOW TO PUBLISH:
//   Firebase console → your project → Build → Firestore Database → Rules tab
//   → paste this entire file, replacing whatever is there → Publish.
//
// If the app is stuck on the loading spinner after logging in, this is almost
// always the cause: Firestore projects start with rules that block every
// read/write (or expire after 30 days), and index.html never got these rules
// published on top of that.
// -----------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profileExists(uid) {
      return exists(/databases/$(database)/documents/sotw_profiles/$(uid));
    }
    function myRole() {
      return profileExists(request.auth.uid)
        ? get(/databases/$(database)/documents/sotw_profiles/$(request.auth.uid)).data.role
        : '';
    }
    function isAdmin() {
      return signedIn() && myRole() in ['owner', 'admin'];
    }
    function isFinance() {
      return signedIn()
        && get(/databases/$(database)/documents/sotw_meta/settings).data.financeUid == request.auth.uid;
    }
    // Only true while an admin has explicitly opened this week's voting window
    // (the "Start Voting" / "End Voting" buttons). Nobody can cast a vote
    // outside that window — this is enforced here, not just in the UI.
    function votingIsOpen() {
      return get(/databases/$(database)/documents/sotw_meta/settings).data.votingOpen == true;
    }

    // Team roster — everyone signed in needs to read this to see names on the
    // vote screen. Only an owner/admin can create, edit, or remove a profile.
    match /sotw_profiles/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Each account's own vote. Nobody else — not even admins — can ever read
    // another person's pick. A vote can only be cast/changed while an admin
    // has voting open, must be for a real teammate, and can never be for
    // yourself. Admins may delete any vote doc (used when removing a
    // teammate or resetting for a new week); everyone may delete their own.
    match /sotw_myvote/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                            && votingIsOpen()
                            && request.resource.data.votedForUid != uid
                            && profileExists(request.resource.data.votedForUid);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Anonymous running vote counts. Any signed-in account may nudge a count
    // while voting is open (as part of casting their own vote), but only
    // admins can ever read the breakdown, and only admins may clear it
    // (weekly reset) — everyone else only ever learns the eventual winner
    // via settings.winnerUids, which never exposes per-person data.
    match /sotw_tally/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && votingIsOpen();
      allow delete: if isAdmin();
    }

    match /sotw_meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Cash-out requests. The requester can read/cancel their own, admins and
    // the assigned finance holder can read/approve/reject any.
    match /sotw_payout_requests/{id} {
      allow read: if isAdmin() || isFinance() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin() || isFinance()
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled');
    }

    // Historical log of paid-out bonuses. Admin/finance only.
    match /sotw_payouts/{id} {
      allow read: if isAdmin() || isFinance();
      allow create: if isAdmin();
    }
  }
}
