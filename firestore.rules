rules_version = '2';

// Blacfox — Star Player of the Week
// -----------------------------------------------------------------
// HOW TO PUBLISH:
//   Firebase console → your project → Build → Firestore Database → Rules tab
//   → paste this entire file, replacing whatever is there → Publish.
//
// If the app is stuck on the loading spinner, this is almost always the cause:
// Firestore projects start with rules that block every read/write (or expire after
// 30 days), and the app never got these rules published on top of that.
//
// There is NO sign-in of any kind behind this app — not a login screen, not even an
// invisible one. That's a deliberate choice: once the wallet/payout system was
// dropped, there was nothing left worth gating behind an identity the database could
// verify, so these rules don't check request.auth at all. Two consequences worth
// knowing, not hiding:
//
//   1. "One name, one person" is a convention, not a guarantee. sotw_claims is
//      create-only so two taps can't both win the SAME name, but nothing stops a
//      second browser from claiming a DIFFERENT already-taken name by going around
//      the app's own UI. Small trusted team, nothing at stake — that trade was made
//      on purpose.
//   2. The host's controls (open/close voting, reveal, manage the roster) are
//      enforced by the app's UI only showing them to whoever's claimed KG — not by
//      the database refusing anyone else.
//
// What DID survive, and is still enforced right here regardless of the above: nobody
// voted for whom is ever recorded anywhere (see sotw_voters), and the per-candidate
// counts (sotw_tally) still can't be read while voting is open — that's about not
// leaking who's voting for whom mid-week, which has nothing to do with identity.
// -----------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function settingsData() {
      return get(/databases/$(database)/documents/sotw_meta/settings).data;
    }
    // Only true while the host has explicitly opened this week's voting window
    // ("Start Voting" / "End Voting"). Uses .get() with a default since a settings
    // doc written before this field existed genuinely has no `votingOpen` key.
    function votingIsOpen() {
      return settingsData().get('votingOpen', false) == true;
    }
    // Null outside a runoff. During a runoff it's the tied uids from last round —
    // voting is still open to everyone, but only for one of these.
    function currentRunoffUids() {
      return settingsData().get('runoffUids', null);
    }
    function currentWeekKey() {
      return settingsData().get('currentWeek', null);
    }
    // True only if `uid` declared 'up' for the week that's active RIGHT NOW — a
    // declaration from a prior week doesn't carry over, so everyone re-declares each
    // week rather than silently staying eligible off a stale pick. This is what
    // actually keeps a 'down' person off the poll: nobody can cast a vote for them.
    function isUpThisWeek(uid) {
      return exists(/databases/$(database)/documents/sotw_stat_status/$(uid))
        && get(/databases/$(database)/documents/sotw_stat_status/$(uid)).data.status == 'up'
        && get(/databases/$(database)/documents/sotw_stat_status/$(uid)).data.weekKey == currentWeekKey();
    }

    // The roster. Shape-checked so a stray write can't corrupt it, but not access-
    // controlled — see the file header. The app's own UI only exposes add/rename/
    // remove to whoever it thinks is the host.
    match /sotw_profiles/{uid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl']);
      allow delete: if true;
    }

    // Marks a name as taken. create-only: Firestore fires `create` exclusively when
    // the document doesn't already exist, so two taps landing on the same name at the
    // same moment resolve to whoever's write lands first, and `update: false` means
    // the loser can never overwrite it. That's the one piece of this app's identity
    // model the database still actually enforces — see the file header for what it
    // doesn't. Releasing a name (handing over the device, or the host freeing one
    // stuck on a browser nobody has any more) is a delete, then a fresh create.
    match /sotw_claims/{uid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['claimedAt']);
      allow update: if false;
      allow delete: if true;
    }

    // Session state everyone reads and, in practice, only the host writes.
    match /sotw_meta/{doc} {
      allow read, write: if true;
    }

    // Proof that someone voted this week — and deliberately nothing else. There is no
    // field for who they picked, here or anywhere: that lives only in the voter's own
    // browser (see lib/localPick.ts). This is what makes "nobody knows who voted for
    // whom" true of the database itself, not just of the screen — and it holds
    // regardless of the rest of this file having no identity checks at all.
    match /sotw_voters/{uid} {
      allow read: if true;
      allow create, update: if votingIsOpen()
                            && request.resource.data.keys().hasOnly(['weekKey', 'ts'])
                            && request.resource.data.weekKey == currentWeekKey();
      allow delete: if true;
    }

    // Anonymous running counts, one doc per candidate. Nudged by exactly the +1/-1
    // that casting or changing a single vote produces — never an arbitrary value, and
    // never for someone who isn't on the roster or isn't 'up' this week.
    //
    // Readable ONLY once voting has closed. That's not about who's asking (nothing
    // here can tell), it's about ordering: watching the live count move while voting
    // is still open is itself a way to infer who just voted, no matter who's looking.
    // It has to become readable the moment voting closes rather than at reveal,
    // because doReveal computes the winner FROM this collection and only then writes
    // revealed:true.
    match /sotw_tally/{uid} {
      allow read: if !votingIsOpen();
      allow create: if votingIsOpen()
                    && isUpThisWeek(uid)
                    && (currentRunoffUids() == null || uid in currentRunoffUids())
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if votingIsOpen()
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count >= 0
                    && (
                      // Up requires eligibility, same as a first vote. Down doesn't:
                      // that's someone correcting away from an earlier pick, and a
                      // candidate who switches to 'down' mid-week must not leave an
                      // already-cast vote stuck with no way to be taken back off.
                      (request.resource.data.count - resource.data.count == 1
                        && isUpThisWeek(uid)
                        && (currentRunoffUids() == null || uid in currentRunoffUids()))
                      || (request.resource.data.count - resource.data.count == -1)
                    );
      allow delete: if true;
    }

    // Self-declared "are my stats up or down this week". Readable by anyone so the
    // vote screen can build the eligible-candidate list client-side (the real
    // enforcement is isUpThisWeek, used above).
    match /sotw_stat_status/{uid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['weekKey', 'status'])
                            && request.resource.data.status in ['up', 'down']
                            && request.resource.data.weekKey == currentWeekKey();
      allow delete: if true;
    }

    // One doc per person per week, written by the reveal alongside reading the tally
    // (the tally itself gets wiped on rollover; this is what's left after). Records
    // only THAT someone received at least one vote, never from whom.
    match /sotw_weekly_activity/{id} {
      allow read, write: if true;
    }
  }
}
