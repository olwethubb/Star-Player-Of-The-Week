rules_version = '2';

// Blacfox — Star Worker of the Week
// -----------------------------------------------------------------
// HOW TO PUBLISH:
//   Firebase console → your project → Build → Firestore Database → Rules tab
//   → paste this entire file, replacing whatever is there → Publish.
//
// If the app is stuck on the loading spinner after logging in, this is almost
// always the cause: Firestore projects start with rules that block every
// read/write (or expire after 30 days), and index.html never got these rules
// published on top of that.
// -----------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profileExists(uid) {
      return exists(/databases/$(database)/documents/sotw_profiles/$(uid));
    }
    function myRole() {
      return profileExists(request.auth.uid)
        ? get(/databases/$(database)/documents/sotw_profiles/$(request.auth.uid)).data.role
        : '';
    }
    function isAdmin() {
      return signedIn() && myRole() in ['owner', 'admin'];
    }
    function isFinance() {
      return signedIn()
        && get(/databases/$(database)/documents/sotw_meta/settings).data.financeUid == request.auth.uid;
    }
    // Only true while an admin has explicitly opened this week's voting window
    // (the "Start Voting" / "End Voting" buttons). Nobody can cast a vote
    // outside that window — this is enforced here, not just in the UI. Uses
    // .get() with a default since a settings doc written before this field
    // existed genuinely has no `votingOpen` key.
    function votingIsOpen() {
      return get(/databases/$(database)/documents/sotw_meta/settings).data.get('votingOpen', false) == true;
    }
    // Only true once an admin has clicked "Reveal" for this week.
    function revealed() {
      return get(/databases/$(database)/documents/sotw_meta/settings).data.get('revealed', false) == true;
    }
    // The candidate the caller is CURRENTLY on record as voting for (or null).
    // Used to bind a tally decrement to the caller's own prior pick — a
    // decrement can only ever be the caller moving away from someone they
    // actually voted for, never an arbitrary rival's count going down.
    function myCurrentVote() {
      return profileExists(request.auth.uid) && exists(/databases/$(database)/documents/sotw_myvote/$(request.auth.uid))
        ? get(/databases/$(database)/documents/sotw_myvote/$(request.auth.uid)).data.votedForUid
        : null;
    }
    // Null outside a runoff. During a runoff it's the tied uids from last round —
    // voting is still open to everyone (except admins), but only for one of these.
    // Uses .get() with a default because any settings doc written before this field
    // existed genuinely has no `runoffUids` key — direct dot access on a missing
    // key is a rules evaluation error, not null.
    function currentRunoffUids() {
      return get(/databases/$(database)/documents/sotw_meta/settings).data.get('runoffUids', null);
    }

    // Team roster — everyone signed in needs to read this to see names on the
    // vote screen. Admins can create/edit/remove anyone. Someone can also create
    // their OWN profile once, for self-signup — but only as role:'member' with a
    // company email matching their actual account, so nobody can self-promote to
    // admin/owner or claim someone else's email. Editing or removing still
    // requires an admin either way. Deliberately has no balance field — see
    // sotw_balances below.
    match /sotw_profiles/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == 'member'
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.email.matches('.*@blacfox[.]com$'));
      allow update, delete: if isAdmin();
    }

    // Blacfox Dollar balances — split out from sotw_profiles specifically so a
    // normal member can never read anyone else's balance (profiles must stay
    // broadly readable for names on the vote screen; balances must not be).
    // Finance can write too since approving a cash-out deducts here directly —
    // but finance may only ever LOWER a balance, never raise one or touch any
    // other field; admins can set it to any valid amount (e.g. correcting an
    // error), and only admins may delete the doc entirely.
    match /sotw_balances/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isFinance());
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['balance'])
                    && request.resource.data.balance is int
                    && request.resource.data.balance >= 0;
      allow update: if request.resource.data.keys().hasOnly(['balance'])
                    && request.resource.data.balance is int
                    && request.resource.data.balance >= 0
                    && (isAdmin()
                        || (isFinance() && request.resource.data.balance < resource.data.balance));
      allow delete: if isAdmin();
    }

    // Each account's own vote. Nobody else — not even admins — can ever read
    // another person's pick. A vote can only be cast/changed by an actual
    // roster member while an admin has voting open, must be for a real
    // teammate, and can never be for yourself. Admins can't vote at all — they're
    // the ones running the reveal, so they sit outside the vote entirely. During
    // a runoff, the pick must also be one of that round's tied names — everyone
    // still votes, just only among the tied players. Admins may delete any vote
    // doc anytime (used when removing a teammate or resetting for a new week);
    // someone may delete their own only while voting is closed — otherwise a
    // delete-then-revote loop could nudge the same candidate's tally forever.
    match /sotw_myvote/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                            && profileExists(request.auth.uid)
                            && !isAdmin()
                            && votingIsOpen()
                            && request.resource.data.votedForUid != uid
                            && profileExists(request.resource.data.votedForUid)
                            && (currentRunoffUids() == null
                                || request.resource.data.votedForUid in currentRunoffUids());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && !votingIsOpen());
    }

    // Anonymous running vote counts. Only a real roster member may nudge a
    // count, only while voting is open, and only by exactly the +1/-1 that
    // casting or changing one vote actually produces (see castVote's
    // transaction) — never an arbitrary value, and never for a non-existent
    // candidate. A decrement is further bound to the caller's own recorded
    // vote — you can only ever bring a count down by moving your OWN pick
    // away from that person, never by targeting a rival directly. (An
    // increment can't be bound the same way — Firestore rules can't see a
    // sibling write's future value earlier in the same transaction — so a
    // scripted client that only ever increments is still a known residual
    // risk; closing that fully needs a server-derived tally, not a rules
    // tweak. This still closes the one-call "zero a rival's count" attack.)
    // Only admins can ever read the breakdown, and only once voting has closed
    // — otherwise watching the live count is itself a way to infer who's voting
    // for whom. It has to be readable BEFORE revealed() flips, not just after:
    // doReveal computes the winner from this collection, then commits
    // revealed:true — gating the read on revealed() itself would make it
    // impossible for any reveal to ever happen. Closing voting first already
    // guarantees nobody can change a vote out from under the count being read.
    // Only admins may clear it (weekly reset) — everyone else only ever learns
    // the eventual winner via settings.winnerUids, which never exposes
    // per-person data.
    match /sotw_tally/{uid} {
      allow read: if isAdmin() && !votingIsOpen();
      allow create: if signedIn() && !isAdmin() && votingIsOpen()
                    && profileExists(request.auth.uid) && profileExists(uid)
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if signedIn() && !isAdmin() && votingIsOpen()
                    && profileExists(request.auth.uid) && profileExists(uid)
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count >= 0
                    && (
                      request.resource.data.count - resource.data.count == 1
                      || (request.resource.data.count - resource.data.count == -1 && myCurrentVote() == uid)
                    );
      allow delete: if isAdmin();
    }

    match /sotw_meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Cash-out requests. The requester can read/cancel their own, admins and
    // the assigned finance holder can read/approve/reject any.
    match /sotw_payout_requests/{id} {
      allow read: if isAdmin() || isFinance() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= get(/databases/$(database)/documents/sotw_balances/$(request.auth.uid)).data.balance;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
                    && (isAdmin() || isFinance()
                        || (signedIn() && resource.data.uid == request.auth.uid
                            && resource.data.status == 'pending'
                            && request.resource.data.status == 'cancelled'));
    }

    // Historical log of paid-out bonuses. Admin/finance only.
    match /sotw_payouts/{id} {
      allow read: if isAdmin() || isFinance();
      allow create: if isAdmin();
    }

    // Append-only audit trail for manual balance edits from the team panel —
    // written alongside every such edit so "why is this balance what it is"
    // never requires a direct Firestore lookup. Only admins trigger these
    // edits today, so only admins may write; nobody may ever update or
    // delete a past entry.
    match /sotw_balance_adjustments/{id} {
      allow read: if isAdmin() || isFinance();
      allow create: if isAdmin();
    }
  }
}
